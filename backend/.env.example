# ─── Base de datos (desarrollo local: XAMPP / MySQL sin SSL) ──────────────────
DB_NAME=constructor_dan
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306

# ─── Base de datos (producción: Aiven u otro MySQL con SSL) ───────────────────
# Si DATABASE_URL está definida, se ignoran las variables DB_* de arriba.
# DATABASE_URL=mysql://usuario:password@host:puerto/basededatos
# Certificado CA de Aiven. Podés pegar el PEM completo o su versión base64.
# Si no se define ni existe backend/ca.pem, se conecta con SSL sin verificar CA.
# DB_CA_CERT=

# ─── Autenticación ───────────────────────────────────────────────────────────
# OBLIGATORIA. El server no arranca sin esto.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV=production  → cookies Secure + SameSite=None
# NODE_ENV=production
# Orígenes extra permitidos por CORS, separados por coma (además de los locales).
# CORS_ORIGINS=https://mi-frontend.com,https://otro-dominio.com
